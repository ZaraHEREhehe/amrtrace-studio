# Demo-only image: includes the existing deterministic fixture loader and its pinned pyarrow dependency.
# Runtime and seed use the same tag, so there is no untracked loading environment.
FROM python:3.12.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PORT=8000
WORKDIR /app
RUN useradd --create-home --uid 10001 amrtrace

COPY requirements-api.txt requirements-dev.txt /app/
RUN python -m pip install --disable-pip-version-check --no-cache-dir \
    -r requirements-api.txt -r requirements-dev.txt

COPY --chown=amrtrace:amrtrace src /app/src
COPY --chown=amrtrace:amrtrace scripts/make_fixture.py scripts/z28_demo_seed.py /app/scripts/
COPY --chown=amrtrace:amrtrace tests/fixtures/mini_cohort /app/tests/fixtures/mini_cohort
COPY --chown=amrtrace:amrtrace data/interpretation /app/data/interpretation
USER amrtrace
EXPOSE 8000
CMD ["python", "-m", "amrtrace.api"]
