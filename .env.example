# Copy to .env for local development. Never commit .env.
# These are local-only defaults; production/deployment secrets must be supplied
# through environment variables or the deployment secret store.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=amrtrace
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Host ports exposed by Docker Compose.
API_PORT=8000
WEB_PORT=8080

# Where uncommitted data lives, relative to the repository root.
AMRTRACE_DATA_DIR=./data

# Review Copilot (optional, I-19). Templates always work offline; a model may only reword them.
# A local model served by Ollama, for example llama3.2 (from Docker, the URL is usually http://host.docker.internal:11434):
AMRTRACE_COPILOT_LOCAL_MODEL=
AMRTRACE_COPILOT_LOCAL_URL=
# The free hosted fallback. Put the key in .env only, never in the repository.
GROQ_API_KEY=
# Groq model to use; empty means openai/gpt-oss-20b. Change it here when Groq retires a model.
AMRTRACE_COPILOT_HOSTED_MODEL=
