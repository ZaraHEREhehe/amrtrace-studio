FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN useradd --create-home --uid 10001 amrtrace

COPY requirements-api.txt /app/requirements-api.txt

RUN python -m pip install     --disable-pip-version-check     --no-cache-dir     -r /app/requirements-api.txt

COPY src /app/src

USER amrtrace

EXPOSE 8000

CMD ["python", "-m", "amrtrace.api"]
